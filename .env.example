# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate_a_random_32_char_string"
BETTER_AUTH_URL="http://localhost:3456"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3456"

# Vercel Blob (optional for local dev)
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token"

# Production URLs (set these in Vercel)
# BETTER_AUTH_URL="https://yourdomain.com"
# NEXT_PUBLIC_BETTER_AUTH_URL="https://yourdomain.com"
